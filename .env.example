# Copy to .env (git-ignored) and fill in. Shared secrets come from the team vault.
PORT=8085
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Shared by every service: openssl rand -hex 32
SK_INTERNAL_TOKEN=
LOG_LEVEL=info

# ElevenLabs (never sent to the browser)
ELEVENLABS_API_KEY=
EL_INTERVIEWER_AGENT_ID=
# Third agent with the debrief prompt; tokens can't carry prompt overrides.
# Leave empty to fall back to the capture interviewer.
EL_INTERVIEWER_DEBRIEF_AGENT_ID=
EL_TUTOR_AGENT_ID=
EL_API_URL=https://api.elevenlabs.io
EL_TIMEOUT_MS=400

# Used by later tickets
# Shared with gateway + tutor
SK_TOOL_SECRET=
EL_WEBHOOK_SECRET=
GATEWAY_INTERNAL_URL=http://localhost:8080
